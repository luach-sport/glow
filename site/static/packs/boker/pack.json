{
"id": "boker",
"name": "בוקר טוב",
"kind": "quotes",
"version": 1,
"items": [
{
"id": "1",
"t": "בוקר חדש, הזדמנות חדשה."
},
{
"id": "2",
"t": "קום, חייך, והתחל."
},
{
"id": "3",
"t": "היום הזה עוד לא נכתב – תכתוב אותו יפה."
},
{
"id": "4",
"t": "כל בוקר הוא מתנה."
},
{
"id": "5",
"t": "תודה על עוד יום."
},
{
"id": "6",
"t": "שתייה, נשימה, ויוצאים לדרך."
},
{
"id": "7",
"t": "הבוקר קובע את היום."
},
{
"id": "8",
"t": "תן לשמש להזכיר לך להאיר."
},
{
"id": "9",
"t": "צעד ראשון של היום – הכי חשוב."
},
{
"id": "10",
"t": "היום אני בוחר בשמחה."
},
{
"id": "11",
"t": "עוד יום לעשות טוב."
},
{
"id": "12",
"t": "בוקר של התחלות."
},
{
"id": "13",
"t": "קודם כל – לחייך."
},
{
"id": "14",
"t": "האנרגיה של הבוקר מחזיקה את כל היום."
},
{
"id": "15",
"t": "אל תמהר. תתחיל נכון."
},
{
"id": "16",
"t": "יום חדש, לב פתוח."
},
{
"id": "17",
"t": "מה הדבר הכי חשוב היום? תתחיל בו."
},
{
"id": "18",
"t": "כל זריחה היא הבטחה."
},
{
"id": "19",
"t": "קם עם כוונה, הולך עם כוח."
},
{
"id": "20",
"t": "היום יהיה יום טוב."
},
{
"id": "21",
"t": "שגרה טובה בונה חיים טובים."
},
{
"id": "22",
"t": "הבוקר שלך – הכללים שלך."
},
{
"id": "23",
"t": "תתחיל מהקל, תמשיך לגדול."
},
{
"id": "24",
"t": "אור חדש בחוץ, וגם בפנים."
},
{
"id": "25",
"t": "בוקר של אמונה."
},
{
"id": "26",
"t": "מה שתעשה הבוקר ילווה אותך כל היום."
},
{
"id": "27",
"t": "שמחה של בוקר – כוח לכל היום."
},
{
"id": "28",
"t": "תודה, אני מוכן."
},
{
"id": "29",
"t": "אחד, שתיים, שלוש – יוצאים!"
},
{
"id": "30",
"t": "יום מלא אפשרויות."
}
]
}