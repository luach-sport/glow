{
"id": "hatzlacha",
"name": "הצלחה ועשייה",
"kind": "quotes",
"version": 1,
"items": [
{
"id": "1",
"t": "הצלחה היא סכום של מאמצים קטנים."
},
{
"id": "2",
"t": "תעבוד בשקט, תתקדם בבטחה."
},
{
"id": "3",
"t": "מטרה ברורה – דרך ברורה."
},
{
"id": "4",
"t": "כל שעה של עבודה מקרבת אותך."
},
{
"id": "5",
"t": "תסיים את מה שהתחלת."
},
{
"id": "6",
"t": "אל תחכה לביטחון. הוא בא תוך כדי."
},
{
"id": "7",
"t": "הפוקוס הוא כוח-על."
},
{
"id": "8",
"t": "עדיף טוב היום ממושלם אף פעם."
},
{
"id": "9",
"t": "מה שמודדים – משתפר."
},
{
"id": "10",
"t": "תעשה את הקשה קודם."
},
{
"id": "11",
"t": "כל יום קצת יותר טוב."
},
{
"id": "12",
"t": "הרגלים קטנים, תוצאות גדולות."
},
{
"id": "13",
"t": "לימוד הוא השקעה לכל החיים."
},
{
"id": "14",
"t": "תכנן את העבודה, ותעבוד לפי התכנון."
},
{
"id": "15",
"t": "הסבלנות היא חלק מהתוכנית."
},
{
"id": "16",
"t": "תהיה גאה בתהליך, לא רק בתוצאה."
},
{
"id": "17",
"t": "אל תפחד לשאול. כך לומדים."
},
{
"id": "18",
"t": "אין עבודה קטנה כשעושים אותה בלב שלם."
},
{
"id": "19",
"t": "לחץ הופך פחם ליהלום."
},
{
"id": "20",
"t": "תחגוג כל התקדמות."
},
{
"id": "21",
"t": "מי שמתמיד – מגיע."
},
{
"id": "22",
"t": "העתיד נבנה עכשיו."
},
{
"id": "23",
"t": "תן לעבודה שלך לדבר."
},
{
"id": "24",
"t": "קודם מתחילים, אחר כך משתפרים."
},
{
"id": "25",
"t": "טעות היום – ניסיון מחר."
},
{
"id": "26",
"t": "כל משימה שנגמרה היא ניצחון."
},
{
"id": "27",
"t": "תזכור למה זה חשוב לך."
},
{
"id": "28",
"t": "החלומות לא עובדים אם אתה לא עובד."
},
{
"id": "29",
"t": "עוד פרק, עוד שלב, עוד צעד."
},
{
"id": "30",
"t": "יש לך את זה."
}
]
}