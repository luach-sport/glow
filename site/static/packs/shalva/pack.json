{
"id": "shalva",
"name": "שלווה והודיה",
"kind": "quotes",
"version": 1,
"items": [
{
"id": "1",
"t": "לנשום עמוק. הכל בסדר."
},
{
"id": "2",
"t": "תודה על הדברים הקטנים."
},
{
"id": "3",
"t": "הרגע הזה מספיק."
},
{
"id": "4",
"t": "שקט בפנים – שקט בחוץ."
},
{
"id": "5",
"t": "אין צורך למהר."
},
{
"id": "6",
"t": "כל נשימה היא מתנה."
},
{
"id": "7",
"t": "תסתכל סביב: יש כל כך הרבה טוב."
},
{
"id": "8",
"t": "הלב רגוע, הראש צלול."
},
{
"id": "9",
"t": "מותר לעצור."
},
{
"id": "10",
"t": "השמחה נמצאת בפשוט."
},
{
"id": "11",
"t": "תודה על מה שיש, ותודה על מה שיבוא."
},
{
"id": "12",
"t": "פחות דאגה, יותר אמונה."
},
{
"id": "13",
"t": "השלווה היא בחירה."
},
{
"id": "14",
"t": "שים את הטלפון רגע, ותסתכל לשמיים."
},
{
"id": "15",
"t": "לאט. בנחת. בשמחה."
},
{
"id": "16",
"t": "כל יום יש לפחות סיבה אחת להודות."
},
{
"id": "17",
"t": "בית שמח מתחיל בלב שמח."
},
{
"id": "18",
"t": "מילה טובה משנה יום."
},
{
"id": "19",
"t": "תן לעצמך רגע של שקט."
},
{
"id": "20",
"t": "החיים יפים, גם כשהם לא מושלמים."
},
{
"id": "21",
"t": "הטוב כבר כאן."
},
{
"id": "22",
"t": "אור קטן בכל פינה."
},
{
"id": "23",
"t": "מה שצריך לבוא – יבוא."
},
{
"id": "24",
"t": "סבלנות היא סוג של שלווה."
},
{
"id": "25",
"t": "הכל מתחיל בתודה."
}
]
}